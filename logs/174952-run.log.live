CoreData: annotation:   Execute trigger creation statement: NSSQLiteStatement <0x100f1de90> on entity '(null)' with sql text 'CREATE TRIGGER IF NOT EXISTS Z_RT_Asset_boundedByRect_INSERT AFTER INSERT ON ZASSET FOR EACH ROW BEGIN INSERT OR REPLACE INTO Z_RT_Asset_boundedByRect (Z_PK, ZLATITUDE_MIN, ZLATITUDE_MAX, ZLONGITUDE_MIN, ZLONGITUDE_MAX) VALUES (NEW.Z_PK, NEW.ZLATITUDE ,NEW.ZLATITUDE, NEW.ZLONGITUDE, NEW.ZLONGITUDE) ; END'
CoreData: annotation:   Execute trigger creation statement: NSSQLiteStatement <0x100f1e580> on entity '(null)' with sql text 'CREATE TRIGGER IF NOT EXISTS Z_RT_Asset_boundedByRect_UPDATE AFTER UPDATE ON ZASSET FOR EACH ROW BEGIN DELETE FROM Z_RT_Asset_boundedByRect WHERE Z_PK = NEW.Z_PK ; INSERT INTO Z_RT_Asset_boundedByRect (Z_PK, ZLATITUDE_MIN, ZLATITUDE_MAX, ZLONGITUDE_MIN, ZLONGITUDE_MAX) VALUES (NEW.Z_PK, NEW.ZLATITUDE ,NEW.ZLATITUDE, NEW.ZLONGITUDE, NEW.ZLONGITUDE) ; END'
