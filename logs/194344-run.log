  color = vertex_color;
  texcoord0_0 = vertex_texcoord0 * texmat0.xy + texmat0.zw;
  texcoord1_0 = vertex_texcoord1 * texmat1.xy + texmat1.zw;
  texcoordD = vec3(gl_Position.xy * texmatD.xy + texmatD.zw * gl_Position.w, gl_Position.w);
