CoreData: annotation:   Execute DA trigger creation statement: NSSQLiteStatement <0x10124f560> on entity 'Asset' with sql text 'DROP TRIGGER IF EXISTS Z_DA_ZADDITIONALASSETATTRIBUTES_Asset_derivedCameraCaptureDevice_PARAMETER_UPDATE'
CoreData: annotation:   Execute DA trigger creation statement: NSSQLiteStatement <0x1012256e0> on entity 'Asset' with sql text 'CREATE TRIGGER IF NOT EXISTS Z_DA_ZASSET_Asset_derivedCameraCaptureDevice_SOURCE_INSERT AFTER INSERT ON ZASSET FOR EACH ROW BEGIN UPDATE ZASSET SET ZDERIVEDCAMERACAPTUREDEVICE = (SELECT ZCAMERACAPTUREDEVICE FROM ZADDITIONALASSETATTRIBUTES WHERE Z_PK = NEW.ZADDITIONALATTRIBUTES) WHERE Z_PK = NEW.Z_PK; SELECT NSCoreDataDATriggerInsertUpdatedAffectedObjectValue('ZASSET', Z_ENT, Z_PK, 'derivedCameraCaptureDevice', ZDERIVEDCAMERACAPTUREDEVICE) FROM ZASSET WHERE Z_PK = NEW.Z_PK; END'
